# ==============================================================================
# ECO HERO — Environment Variables (.env.example)
# ==============================================================================

# --- Core Server & Security ---
# Runtime mode ('production' on Railway/Cloud Run, 'development' locally)
NODE_ENV=production
# HTTP port Railway/Cloud Run injects automatically (defaults to 3000)
PORT=3000
# REQUIRED in production: random secret (>= 32 chars) used to sign session tokens (`openssl rand -hex 32`)
SESSION_SECRET=

# --- Admin Access Control ---
# Comma-separated verified emails granted Super Admin role
SUPER_ADMIN_EMAILS=
# Comma-separated numeric Telegram user IDs granted Super Admin role
SUPER_ADMIN_TELEGRAM_IDS=

# --- Firebase (Auth & Firestore REST Sync) ---
# Web API key (optional if firebase-applet-config.json is present)
FIREBASE_API_KEY=
# Firebase project ID override (optional if firebase-applet-config.json is present)
FIREBASE_PROJECT_ID=
# Firestore database ID override (optional, defaults to '(default)' or config value)
FIREBASE_DATABASE_ID=

# --- Telegram Bot & Mini App ---
# Telegram bot token from @BotFather (required for Telegram bot & notifications)
TELEGRAM_BOT_TOKEN=
# Telegram bot username without '@' (e.g. ecohero_uz_bot)
TELEGRAM_BOT_USERNAME=ecohero_uz_bot
# Secret token verifying incoming Telegram webhook requests (recommended in production)
TELEGRAM_WEBHOOK_SECRET=
# Set to 'true' to disable polling/webhook on secondary server replicas
DISABLE_BOT_LISTENER=false

# --- Google Gemini AI ---
# Gemini API key for AI eco-assistant, hazard checks, and photo verification
GEMINI_API_KEY=

# --- Public URLs & Networking ---
# Primary HTTPS URL of your deployed app (auto-detected on Railway via RAILWAY_PUBLIC_DOMAIN)
PUBLIC_APP_URL=https://sizning-domeningiz.uz
# Explicit frontend app URL for client links/SEO
VITE_APP_URL=https://sizning-domeningiz.uz
# Optional public backend API base URL if frontend & backend are hosted separately
VITE_API_BASE_URL=
BACKEND_PUBLIC_URL=
FRONTEND_URL=
# Disable local Cloudflare quick-tunnel in production
USE_QUICK_TUNNEL=false
# Optional Cloudflare named tunnel token
CLOUDFLARE_TUNNEL_TOKEN=

# --- Maps & 3D Globe (Optional) ---
# Google Maps JavaScript API key for HD satellite/street layers
VITE_GOOGLE_MAPS_API_KEY=
# Satellite imagery provider key ('esri_world_imagery' or custom)
MAP_SATELLITE_PROVIDER=esri_world_imagery
MAP_SATELLITE_TILE_URL=
MAP_SATELLITE_ATTRIBUTION=
# Cesium Ion access token for 3D globe terrain/imagery
CESIUM_ION_TOKEN=
CESIUM_3D_TILES_URL=

# --- SEO ---
# Google Search Console verification meta tag content
GOOGLE_SITE_VERIFICATION=
